# Database Configuration
# Replace with your PostgreSQL connection string
DATABASE_URL='postgresql://user:password@host:5432/database?connect_timeout=15'

# NextAuth Configuration
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://your-domain.vercel.app

# Abacus.AI API Configuration
ABACUSAI_API_KEY=your_abacus_api_key_here
WEB_APP_ID=your_web_app_id_here

# Notification IDs for Abacus.AI (Optional - for email notifications)
NOTIF_ID_ASSESSMENT_PDF_REPORT=your_pdf_notification_id
NOTIF_ID_ASSESSMENT_INVITATION=your_invitation_notification_id
